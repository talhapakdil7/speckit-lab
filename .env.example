# PostgreSQL connection string. The integration test suite uses TEST_DATABASE_URL.
DATABASE_URL=postgres://auth:auth@localhost:5432/auth
TEST_DATABASE_URL=postgres://auth:auth@localhost:5432/auth_test

# JWT signing key. MUST be at least 32 bytes of entropy in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me-to-32-plus-bytes-of-real-entropy-XXXX

# bcrypt cost factor. 12 yields ~150-250 ms/hash on modern 2-vCPU instances.
BCRYPT_COST=12

# Public base URL embedded in password-reset email links.
PUBLIC_URL=http://localhost:3000

# Email transport URL: smtp://..., file://./tmp/emails/, or memory://
SMTP_URL=memory://

# HTTP listen port.
PORT=3000

# Rate-limit thresholds (defaults from research.md §4); env-tunable.
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_REGISTER_PER_IP_PER_HOUR=10
RATE_LIMIT_RESET_PER_EMAIL_PER_HOUR=3
RATE_LIMIT_RESET_PER_IP_PER_HOUR=10
